+// privateHTTPRecovery keeps credentials, hidden data and panic values out of logs.
+func privateHTTPRecovery() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		defer func() {
+			if recover() != nil {
+				logger.Error("HTTP handler failed")
+				c.AbortWithStatus(http.StatusInternalServerError)
+			}
+		}()
+		c.Next()
+	}
 }
 
