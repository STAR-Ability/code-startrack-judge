+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 Code Startrack contributors.
+// Code Startrack addition: private-route authentication and log leakage regression.
+package main
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/criyle/go-judge/cmd/go-judge/config"
+	"github.com/gin-gonic/gin"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+func TestStartrackPrivateHTTPRoutes(t *testing.T) {
+	var logs bytes.Buffer
+	previous := logger
+	logger = zap.New(zapcore.NewCore(zapcore.NewJSONEncoder(zap.NewProductionEncoderConfig()), zapcore.AddSync(&logs), zap.DebugLevel))
+	defer func() { logger = previous }()
+	secret := strings.Repeat("canary", 8)
+	conf := &config.Config{Release: true, AuthToken: secret, Dir: "/private/internal/store"}
+	handler := initHTTPMux(conf, nil, nil, map[string]any{"private": "internal"})
+	handler.(*gin.Engine).GET("/startrack-panic", func(c *gin.Context) { panic("private-panic-" + secret) })
+	cases := []struct {
+		method, path, authorization string
+		want                        int
+	}{
+		{http.MethodGet, "/version", "", http.StatusUnauthorized},
+		{http.MethodGet, "/version", "Bearer wrong", http.StatusUnauthorized},
+		{http.MethodPost, "/run", "", http.StatusUnauthorized},
+		{http.MethodGet, "/file", "", http.StatusUnauthorized},
+		{http.MethodGet, "/version", "Bearer " + secret, http.StatusOK},
+		{http.MethodGet, "/config", "Bearer " + secret, http.StatusNotFound},
+		{http.MethodGet, "/ws", "Bearer " + secret, http.StatusNotFound},
+		{http.MethodGet, "/stream", "Bearer " + secret, http.StatusNotFound},
+		{http.MethodGet, "/startrack-panic?private-query=" + secret, "Bearer " + secret, http.StatusInternalServerError},
+	}
+	for _, item := range cases {
+		req := httptest.NewRequest(item.method, item.path, nil)
+		req.Header.Set("Authorization", item.authorization)
+		req.Header.Set("X-Private-Canary", "private-header-"+secret)
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, req)
+		if response.Code != item.want {
+			t.Fatalf("%s %s: status %d, want %d", item.method, item.path, response.Code, item.want)
+		}
+		if strings.Contains(response.Body.String(), conf.Dir) {
+			t.Fatal("internal store exposed in diagnostic response")
+		}
+	}
+	if strings.Contains(logs.String(), secret) {
+		t.Fatal("runtime token leaked into startup/request logs")
+	}
+	if initMonitorHTTPMux(conf) != nil {
+		t.Fatal("default profile unexpectedly enables monitor listener")
+	}
+}
